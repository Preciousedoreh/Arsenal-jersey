// Prisma schema for the Jersey Store API.
// Money is always stored as integer minor units (cents/kobo) — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Auth (Better Auth core tables) ───────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  orders             Order[]             @relation("CustomerOrders")
  cancelledOrders    Order[]             @relation("CancelledBy")
  inventoryMovements InventoryMovement[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Failed-login tracking for account lockout. Keyed by normalised email so it works
/// identically whether or not the account exists (no user enumeration).
model LoginLockout {
  email          String    @id
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("login_lockouts")
}

// ─────────────────────────────── Catalogue & inventory ───────────────────────────────

enum ProductBadge {
  NEW
  LIMITED
}

/// Shirt sizes. Stock is tracked per size (see ProductVariant).
enum Size {
  S
  M
  L
  XL
  XXL
  /// One size — for non-apparel items such as scarves and mugs.
  OS
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  imageUrl    String?
  /// Lower numbers first.
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  subtitle          String?
  description       String        @default("")
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceCents        Int
  currency          String        @db.Char(3)
  sku               String        @unique
  /// Ordered gallery URLs: [front, back, detail, ...].
  images            String[]      @default([])
  features          String[]      @default([])
  /// [{ label, value }] rows shown under "Details & care".
  specs             Json          @default("[]")
  tags              String[]      @default([])
  badge             ProductBadge?
  isFeatured        Boolean       @default(false)
  isBestSeller      Boolean       @default(false)
  /// Name & number printing offered for this product.
  isCustomizable    Boolean       @default(false)
  printPriceCents   Int           @default(1500)
  /// CSS colour (#RRGGBB) of the printed lettering, for the live preview.
  printColor        String?
  colorName         String?
  colorHex          String?
  /// Display-only placeholders until a reviews module exists. Not editable through the admin API.
  rating            Float?
  reviewCount       Int           @default(0)
  /// Alert admins when any size of this product drops to or below this many units.
  lowStockThreshold Int           @default(5)
  isActive          Boolean       @default(true)
  /// Set when a product that has orders is "deleted" (soft delete).
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([categoryId, isActive])
  @@index([name])
  @@map("products")
}

/// One row per size of a product. Stock lives here and is guarded by a CHECK (stockQuantity >= 0).
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          Size
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, size])
  @@map("product_variants")
}

enum InventoryReason {
  RESTOCK
  ORDER
  CANCEL
  ADJUSTMENT
}

/// Append-only audit log of every stock change (per size).
model InventoryMovement {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change     Int
  stockAfter Int
  reason     InventoryReason
  note       String?
  orderId    String?
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminId    String?
  admin      User?           @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

// ─────────────────────────────── Orders ───────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)
  status           OrderStatus @default(PENDING)
  currency         String      @db.Char(3)
  subtotalCents    Int
  totalCents       Int
  /// Free-form shipping address snapshot (validated by zod at the API boundary).
  shippingAddress  Json?
  paymentProvider  String?
  paymentReference String?     @unique
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledById    String?
  cancelledBy      User?       @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items     OrderItem[]
  movements InventoryMovement[]
  payments  Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// One row per payment attempt. Every reference ever issued stays resolvable, so a webhook for
/// an older attempt (customer clicked "pay" twice) is never lost.
model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider    String
  reference   String        @unique
  amountCents Int
  currency    String        @db.Char(3)
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

/// Line item with a snapshot of the product's name/sku/price at purchase time.
model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName    String
  productSku     String
  size           Size
  /// { name, number } printed on the shirt, if personalised.
  customization  Json?
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}
