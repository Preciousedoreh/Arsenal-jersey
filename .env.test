# Loaded automatically by vitest. Safe to commit: points only at the local docker test database.
NODE_ENV=test
PORT=0
LOG_LEVEL=silent
TRUST_PROXY=false
STORE_NAME="Jersey Store"
STORE_CURRENCY=USD
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://store:store@localhost:5433/jersey_store_test?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=test-secret-test-secret-test-secret-1234
PASSWORD_BREACH_CHECK=false
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=AdminPassw0rd!
ADMIN_NAME="Test Admin"
RATE_LIMIT_STORE=memory
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100000
# Better Auth's own per-IP limiter is off in tests (every request comes from 127.0.0.1);
# the per IP+email login limiter and account lockout stay on and are tested.
AUTH_RATE_LIMIT_ENABLED=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOCKOUT_THRESHOLD=8
LOCKOUT_DURATION_MINUTES=30
EMAIL_TRANSPORT=memory
EMAIL_FROM="Jersey Store <no-reply@test.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
QUEUE_DRIVER=inline
RUN_WORKERS_IN_PROCESS=false
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=test-webhook-secret-123456
API_DOCS_ENABLED=true
