# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Express "trust proxy" setting: false | true | number of hops | comma-separated subnets
TRUST_PROXY=false

# ---------- Store ----------
STORE_NAME="Jersey Store"
# ISO-4217 code used for new products. All money is stored as integer minor units (cents/kobo).
STORE_CURRENCY=USD

# ---------- URLs ----------
# Public base URL of THIS API (used for auth callbacks and email links)
BETTER_AUTH_URL=http://localhost:4000
# The frontend app (used for redirects after email verification / password reset)
FRONTEND_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# ---------- Database / Redis ----------
DATABASE_URL=postgresql://store:store@localhost:5433/jersey_store?schema=public
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Check new passwords against the Have I Been Pwned breached-password corpus (free, k-anonymity API)
PASSWORD_BREACH_CHECK=true

# ---------- Seeded admin (used by `npm run db:seed`) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!Admin2026
ADMIN_NAME="Store Admin"

# ---------- Rate limiting & lockout ----------
# memory (single instance / dev) | redis (production, multi-instance)
RATE_LIMIT_STORE=memory
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
AUTH_RATE_LIMIT_ENABLED=true
# Login attempts allowed per IP + email combination per window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Consecutive failed logins (from any IP) before the account is locked
LOCKOUT_THRESHOLD=10
LOCKOUT_DURATION_MINUTES=30

# ---------- Email ----------
# smtp (Mailpit in dev: UI at http://localhost:8025) | memory (tests)
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Jersey Store <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Background jobs ----------
# bullmq (Redis-backed) | inline (process immediately in-process; tests)
QUEUE_DRIVER=bullmq
# Run the email worker inside the API process. Set false and run `npm run start:worker` separately to scale.
RUN_WORKERS_IN_PROCESS=true

# ---------- Payments ----------
# Only "mock" is implemented. Stripe/Paystack can be added behind the PaymentService interface.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ---------- Docs ----------
API_DOCS_ENABLED=true
